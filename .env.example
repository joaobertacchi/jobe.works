# Copy to .env (git-ignored) and fill in locally. Values prefixed with VITE_
# are compiled into the static bundle and are public, never secrets.

# PostHog project API key (phc_...). Leave empty to disable the PostHog tracker.
VITE_POSTHOG_KEY=
# Optional ingestion host. Defaults to https://us.i.posthog.com.
VITE_POSTHOG_HOST=
